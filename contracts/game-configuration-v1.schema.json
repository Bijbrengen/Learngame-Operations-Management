{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leerpret.nl/contracts/game-configuration-v1.schema.json",
  "title": "LEARNGame OM Game Configuration Schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_id",
    "name",
    "is_preset",
    "base_template",
    "created_at",
    "updated_at",
    "settings"
  ],
  "properties": {
    "config_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "is_preset": {
      "type": "boolean"
    },
    "base_template": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "game_type",
        "money",
        "pnl",
        "opening_balance_enabled",
        "revenue_balance_enabled",
        "production_planning_enabled",
        "intermediate_stock",
        "opportunity_costs",
        "role_freedom",
        "organization_model",
        "funding_incentive",
        "price_mode",
        "logistics_organization",
        "product_type_count",
        "customer_order_mode"
      ],
      "properties": {
        "game_type": {
          "type": "string"
        },
        "money": {
          "type": "boolean"
        },
        "pnl": {
          "type": "boolean"
        },
        "opening_balance_enabled": {
          "type": "boolean"
        },
        "revenue_balance_enabled": {
          "type": "boolean"
        },
        "production_planning_enabled": {
          "type": "boolean"
        },
        "intermediate_stock": {
          "type": "boolean"
        },
        "opportunity_costs": {
          "type": "boolean"
        },
        "role_freedom": {
          "type": "boolean"
        },
        "organization_model": {
          "enum": ["single_enterprise", "independent_enterprises", "school_learning_path"]
        },
        "funding_incentive": {
          "enum": ["quality", "balanced", "financing"]
        },
        "multiple_colors": {
          "type": "boolean",
          "default": false
        },
        "editable_color_layers": {
          "type": "array",
          "items": {
            "enum": ["groundPlate", "layer1", "layer2", "layer3"]
          },
          "uniqueItems": true,
          "default": []
        },
        "price_mode": {
          "enum": ["fixed", "free"]
        },
        "logistics_organization": {
          "enum": ["product", "functional"]
        },
        "production_processes": {
          "type": "array",
          "items": {
            "enum": ["parallel", "sequential"]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "product_type_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "customer_order_mode": {
          "enum": ["free", "required"]
        },
        "has_supplier": {
          "type": "boolean"
        },
        "currency_mode": {
          "enum": ["single", "multiple"]
        },
        "base_currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "enabled_currencies": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[A-Z]{3}$"},
          "minItems": 1,
          "uniqueItems": true
        },
        "exchange_rates": {
          "type": "object",
          "additionalProperties": {"type": "number", "exclusiveMinimum": 0}
        },
        "enabled_roles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
