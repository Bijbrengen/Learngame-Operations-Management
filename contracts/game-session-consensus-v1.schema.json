{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leerpret.nl/contracts/game-session-consensus-v1.schema.json",
  "title": "LEARNGame OM game session and consensus v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "session_id", "join_code", "session_type", "difficulty_level", "game_config", "origin", "status", "game_master_member_id", "required_role_ids", "members", "role_vacancies", "consensus", "virtual_agents", "created_at", "updated_at"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "session_id": {"type": "string", "minLength": 8, "maxLength": 120},
    "join_code": {"type": "string", "pattern": "^[A-Z0-9]{6,10}$"},
    "session_type": {"enum": ["closed", "open", "semi_closed"]},
    "difficulty_level": {"enum": ["easy", "normal", "hard"]},
    "game_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["play_mode", "game_type", "money", "pnl", "opening_balance_enabled", "revenue_balance_enabled", "intermediate_stock", "opportunity_costs", "role_freedom", "multiple_colors", "editable_color_layers", "price_mode", "logistics_organization", "product_type_count", "customer_order_mode", "enabled_roles"],
      "properties": {
        "play_mode": {"enum": ["physical", "digital"]},
        "game_type": {"enum": ["entrepreneurial", "lo1", "lo2", "lo3", "lo4", "lo5", "lo6", "lo7"]},
        "money": {"type": "boolean"},
        "pnl": {"type": "boolean"},
        "opening_balance_enabled": {"type": "boolean"},
        "revenue_balance_enabled": {"type": "boolean"},
        "intermediate_stock": {"type": "boolean"},
        "opportunity_costs": {"type": "boolean"},
        "role_freedom": {"type": "boolean"},
        "multiple_colors": {"type": "boolean"},
        "editable_color_layers": {
          "type": "array",
          "items": {"enum": ["groundPlate", "layer1", "layer2", "layer3"]},
          "uniqueItems": true
        },
        "price_mode": {"enum": ["fixed", "free"]},
        "logistics_organization": {"enum": ["product", "functional"]},
        "production_processes": {
          "type": "array",
          "items": {"enum": ["parallel", "sequential"]},
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "product_type_count": {"type": "integer", "minimum": 1, "maximum": 9},
        "customer_order_mode": {"enum": ["free", "required"]},
        "enabled_roles": {
          "type": "array",
          "items": {
            "enum": [
              "customer",
              "logistics_manager",
              "raw_warehouse",
              "production_1",
              "production_2",
              "production_3",
              "production_a",
              "production_b",
              "production_c",
              "finished_warehouse",
              "sales",
              "finance",
              "supplier",
              "transporter"
            ]
          },
          "maxItems": 14,
          "uniqueItems": true
        }
      }
    },
    "origin": {"enum": ["managed", "free_game"]},
    "status": {"enum": ["lobby", "ready", "running", "finished"]},
    "game_master_member_id": {"type": "string", "minLength": 8, "maxLength": 120},
    "required_role_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 80},
      "uniqueItems": true
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["member_id", "present", "assigned_role_id", "match_percent", "reliability", "joined_at", "last_seen_at"],
        "properties": {
          "member_id": {"type": "string", "minLength": 8, "maxLength": 120},
          "present": {"type": "boolean"},
          "assigned_role_id": {"type": ["string", "null"], "maxLength": 80},
          "match_percent": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
          "reliability": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
          "joined_at": {"type": "string", "format": "date-time"},
          "last_seen_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "role_vacancies": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 80},
      "uniqueItems": true
    },
    "consensus": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["proposal_id", "proposal", "requested_by_member_id", "required_member_ids", "approved_member_ids", "status", "created_at"],
      "properties": {
        "proposal_id": {"type": "string", "minLength": 8, "maxLength": 120},
        "proposal": {"const": "fill_vacant_roles_with_virtual_agents"},
        "requested_by_member_id": {"type": "string", "minLength": 8, "maxLength": 120},
        "required_member_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 8, "maxLength": 120},
          "uniqueItems": true
        },
        "approved_member_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 8, "maxLength": 120},
          "uniqueItems": true
        },
        "status": {"enum": ["open", "accepted", "rejected", "withdrawn"]},
        "created_at": {"type": "string", "format": "date-time"},
        "rejected_by_member_id": {"type": "string", "minLength": 8, "maxLength": 120}
      }
    },
    "virtual_agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agent_id", "role_id", "activated_by_proposal_id"],
        "properties": {
          "agent_id": {"type": "string", "minLength": 8, "maxLength": 120},
          "role_id": {"type": "string", "minLength": 1, "maxLength": 80},
          "activated_by_proposal_id": {"type": "string", "minLength": 8, "maxLength": 120}
        }
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "current_member_id": {"type": "string", "minLength": 8, "maxLength": 120},
    "is_game_master": {"type": "boolean"}
  }
}
